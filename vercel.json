{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js?__route=/api/$1"
    },
    {
      "source": "/chat",
      "destination": "/index.html"
    },
    {
      "source": "/chat/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
